# Copy to apps/api/.env for local development. Never commit the real .env.
DATABASE_URL=postgresql://recall:recall@localhost:54329/recall_dev
PORT=3000
# The web app's origin: CORS allows only this origin (with credentials), and the
# magic-link verification redirects back to it.
WEB_ORIGIN=http://localhost:5173
# Public URL of this API, used to build magic links.
API_ORIGIN=http://localhost:3000
# console = print magic links to this terminal (development); file = append them to
# MAIL_OUTBOX_FILE (automated tests); resend = send real email (production).
MAIL_MODE=console
MAIL_OUTBOX_FILE=
RESEND_API_KEY=
MAIL_FROM=recall <login@example.com>
# The session cookie is always httpOnly + SameSite=Lax; Secure unless set to false.
COOKIE_SECURE=true
