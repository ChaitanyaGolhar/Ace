// Brief §9.2, refined. Tables and columns are snake_case in Postgres (@@map / @map) so
// the hand-written SQL in src/sync and analytics.sql stays readable.
//
// Synced rows (decks, cards, review_logs) keep the client's UUID v7 as primary key and
// epoch-ms timestamps as BIGINT, exactly like the domain model. server_seq comes from the
// global sequence change_seq (created in the first migration) and is reassigned on every
// insert or change, which is what /sync/pull pages through.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  sessions  Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model MagicLinkToken {
  id        String    @id @default(uuid())
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("magic_link_tokens")
}

model Deck {
  id         String  @id
  userId     String  @map("user_id")
  name       String
  source     String
  prebuiltId String? @map("prebuilt_id")
  createdAt  BigInt  @map("created_at")
  updatedAt  BigInt  @map("updated_at")
  deletedAt  BigInt? @map("deleted_at")
  serverSeq  BigInt  @map("server_seq")

  @@index([userId, serverSeq])
  @@map("decks")
}

model Card {
  id        String  @id
  userId    String  @map("user_id")
  deckId    String  @map("deck_id")
  front     String
  back      String
  createdAt BigInt  @map("created_at")
  updatedAt BigInt  @map("updated_at")
  deletedAt BigInt? @map("deleted_at")
  serverSeq BigInt  @map("server_seq")

  @@index([userId, serverSeq])
  @@map("cards")
}

model ReviewLog {
  id         String  @id
  userId     String  @map("user_id")
  cardId     String  @map("card_id")
  rating     Int
  reviewedAt BigInt  @map("reviewed_at")
  durationMs Int     @map("duration_ms")
  deviceId   String  @map("device_id")
  voidedAt   BigInt? @map("voided_at")
  serverSeq  BigInt  @map("server_seq")

  @@index([userId, serverSeq])
  @@index([cardId])
  @@map("review_logs")
}

model Event {
  id         String @id
  userId     String @map("user_id")
  type       String
  occurredAt BigInt @map("occurred_at")
  deviceId   String @map("device_id")
  props      Json
  serverSeq  BigInt @map("server_seq")

  @@index([userId, serverSeq])
  @@index([type])
  @@map("events")
}
